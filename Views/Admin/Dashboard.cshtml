@{
    ViewBag.Title = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml"; // Pointing to the layout with sidebar
}
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;700&display=swap" rel="stylesheet" />

<style>
    body {
        font-family: 'Poppins', sans-serif;
        background-color: #F5F5DC;
        margin: 0;
        padding: 0;
    }

    .main-content {
        padding-top: 40px;
        padding-left: 20px;
        margin-left: 200px;
        margin-right: 20px;
        padding-right: 20px;
        min-height: 100vh;
        background-color: #FFF8DC;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        flex-grow: 1;
        transition: all 0.3s ease-in-out;
    }

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        padding-bottom: 10px;
        border-bottom: 2px solid #4B2E2E;
    }

        .dashboard-header h1 {
            color: #4B2E2E;
            font-size: 32px;
        }

        .dashboard-header p {
            font-weight: 500;
            color: #4B2E2E;
        }

    .card-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 30px;
    }

    .card {
        background-color: white;
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 8px 16px rgba(0,0,0,0.1);
        transition: transform 0.3s ease-in-out;
        text-align: center;
    }

        .card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 24px rgba(0,0,0,0.15);
        }

        .card h2 {
            font-size: 24px;
            margin-bottom: 12px;
            color: #4B2E2E;
        }

        .card p {
            font-size: 20px;
            color: #333;
            font-weight: bold;
        }
</style>

<div class="main-content">
    <div class="dashboard-header">
        <h1>Welcome Admin</h1>
        <p>@DateTime.Now.ToString("dddd, dd MMM yyyy")</p>
    </div>

    <div class="card-container">
        <div class="card">
            <h2>Total Products</h2>
            <p>@ViewBag.TotalProducts</p>
        </div>
        <div class="card">
            <h2>Total Categories</h2>
            <p>@ViewBag.TotalCategories</p>
        </div>
    </div>
</div>
