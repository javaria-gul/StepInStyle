@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Admin Panel</title>
    <meta name="viewport" content="width=device-width" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;700&display=swap" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
    <style>

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #F5F5DC;
            margin: 0;
            padding: 0;
        }

        .dashboard-container {
            display: flex;
        }

        /* Sidebar Styling */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 200px;
            height: 100%;
            background-color: #4B2E2E;
            color: #F5F5DC;
            padding-top: 20px;
            box-shadow: 2px 0 8px rgba(0, 0, 0, 0.2);
            z-index: 998;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

            .sidebar a {
                display: block;
                padding: 14px 25px;
                color: #F5F5DC;
                text-decoration: none;
                font-weight: 600;
                transition: all 0.3s ease;
                font-size: 16px;
            }

                .sidebar a:hover {
                    background-color: #5E3F3F;
                    color: white;
                    padding-left: 30px;
                }

        .logo-text {
            font-size: 24px;
            font-weight: bold;
            color: #F5F5DC;
            margin: 0 0 20px 25px;
            text-shadow: 0 0 5px rgba(255,255,255,0.5), 0 0 10px rgba(255,255,255,0.3);
            animation: glow 2s infinite alternate;
        }

        @@keyframes glow {
            from {
                text-shadow: 0 0 5px #fff;
            }

            to {
                text-shadow: 0 0 20px #fff;
            }
        }

        .admin-footer {
            display: flex;
            align-items: center;
            margin-left: 10px;
            margin-bottom: 20px;
        }

        .admin-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: #F5F5DC;
            color: #4B2E2E;
            font-weight: bold;
            line-height: 40px;
            font-size: 18px;
            text-align: center;
            margin-right: 10px;
        }

        .admin-label {
            color: #F5F5DC;
            font-size: 14px;
            font-weight: 500;
        }

        /* Responsive */
        @@media screen and (max-width: 768px) {
            .sidebar {
                position: relative;
                width: 100%;
                height: auto;
            }

            .dashboard-container {
                flex-direction: column;
            }
        }
    </style>
</head>
<body>
    <div class="dashboard-container">
        <div class="sidebar">
            <div>
                <div class="logo-text">StepInStyle</div>
                <a href="@Url.Action("Dashboard", "Admin")">Dashboard</a>
                <a href="@Url.Action("Index", "Category")">Categories</a>
                <a href="@Url.Action("Index", "Product")">Products</a>
                <a href="#">Users</a>
                <a href="@Url.Action("Logout", "Account")">Logout</a>
            </div>
            <div class="admin-footer">
                <div class="admin-avatar">A</div>
                <div class="admin-label">Admin</div>
            </div>
        </div>

        @RenderBody() <!-- For injecting page content if needed -->
    </div>
</body>
</html>
