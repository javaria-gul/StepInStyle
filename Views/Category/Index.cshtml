@model List<StepInStyle.Models.Category>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Categories</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet" />
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #F5F5DC;
        }

        .main-content {
            margin-left: 220px;
            padding: 20px;
        }

        h2 {
            color: #4B2E2E;
            font-weight: 600;
        }

        .btn {
            font-weight: 600;
            border-radius: 6px;
            padding: 10px 16px;
            text-decoration: none;
            transition: background 0.3s ease;
            border: none;
        }

        .btn-add {
            background-color: #4B2E2E;
            color: #F5F5DC;
        }

            .btn-add:hover {
                background-color: #3a2323;
                color: #fff;
            }

        .btn-delete {
            background-color: #b33a3a;
            color: white;
        }

            .btn-delete:hover {
                background-color: #932323;
            }

        .table-container {
            margin-top: 25px;
            overflow-x: auto;
            border-radius: 8px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background-color: white;
        }

        thead th {
            background-color: #4B2E2E;
            color: #F5F5DC;
            padding: 12px;
            position: sticky;
            top: 0;
        }

        td {
            padding: 12px;
            border-bottom: 1px solid #ddd;
            text-align: center;
        }

        tr:hover {
            background-color: #f3f3e9;
        }

        /* Popup styles */
        .popup-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.6);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 9999;
        }

        .popup-card {
            background: #fff;
            border-radius: 10px;
            padding: 30px;
            width: 400px;
            position: relative;
            box-shadow: 0 8px 16px rgba(0,0,0,0.2);
        }

            .popup-card h3 {
                margin-top: 0;
                color: #4B2E2E;
                font-weight: 600;
            }

            .popup-card label {
                font-weight: 600;
                margin-top: 10px;
                display: block;
            }

            .popup-card input, .popup-card textarea {
                width: 100%;
                padding: 8px;
                border: 1px solid #ccc;
                border-radius: 6px;
                margin-top: 6px;
                margin-bottom: 15px;
                font-family: 'Poppins';
            }

            .popup-card .btn {
                margin-right: 10px;
            }

        .close-btn {
            position: absolute;
            top: 12px;
            right: 16px;
            background: none;
            border: none;
            font-size: 20px;
            font-weight: bold;
            color: #4B2E2E;
            cursor: pointer;
        }
    </style>
</head>
<body>

    <div class="main-content">
        <h2>Categories</h2>
        <button class="btn btn-add" onclick="openPopup()">Add New Category</button>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <tr>
                            <td>@(i + 1)</td>
                            <td>@Model[i].CategoryName</td>
                            <td>@Model[i].Description</td>
                            <td>
                                <button class="btn btn-delete" onclick="confirmDelete(@Model[i].CategoryId)">Delete</button>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Add Category Popup -->
    <div class="popup-overlay" id="popupOverlay">
        <div class="popup-card">
            <button class="close-btn" onclick="closePopup()">×</button>
            <h3>Add Category</h3>
            @using (Html.BeginForm("Add", "Category", FormMethod.Post))
            {
                <label>Category Name<span style="color:red">*</span></label>
                <input type="text" name="CategoryName" required />

                <label>Description</label>
                <textarea name="Description" rows="3"></textarea>

                <button type="submit" class="btn btn-add">Add</button>
                <button type="button" class="btn btn-delete" onclick="closePopup()">Cancel</button>
            }
        </div>
    </div>
    <!-- Delete Confirmation Popup -->
    <div class="popup-overlay" id="deletePopup">
        <div class="popup-card">
            <button class="close-btn" onclick="closeDeletePopup()">×</button>
            <h3>Confirm Delete</h3>
            <p>Are you sure you want to delete this category?</p>

            @using (Html.BeginForm("Delete", "Category", FormMethod.Post, new { id = "deleteForm" }))
            {
                @Html.Hidden("id")
                <button type="submit" class="btn btn-delete">Delete</button>
                <button type="button" class="btn btn-add" onclick="closeDeletePopup()">Cancel</button>
            }
        </div>
    </div>


    <script>
        function openPopup() {
            document.getElementById("popupOverlay").style.display = "flex";
        }

        function closePopup() {
            document.getElementById("popupOverlay").style.display = "none";
        }
       
        function confirmDelete(id) {
            document.querySelector("#deleteForm input[name='id']").value = id;
            document.getElementById("deletePopup").style.display = "flex";
        }


            function closeDeletePopup() {
                document.getElementById("deletePopup").style.display = "none";
        }
   

    </script>

</body>
</html>
