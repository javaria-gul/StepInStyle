@model List<StepInStyle.Models.Product>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>All Products</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet" />

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            margin: 0;
            padding: 0;
            background-color: #F5F5DC;
        }

       
        .main-content {
            margin-left: 220px;
           /* padding: 10px;*/
           /* margin-top: 2px;*/
            padding-right:12px;
            margin-top:2px;
        }

        h2 {
            color: #4B2E2E;
            margin-bottom: 20px;
            font-weight: 600;
        }

        .btn-success {
            background-color: #4B2E2E;
            color: #F5F5DC;
            padding: 10px 20px;
            border: none;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 600;
            transition: background 0.3s ease;
        }

        .btn-success:hover {
            background-color: #3a2323;
            color: #fff;
        }

        .product-table-container {
            max-height: 500px;
            overflow-y: auto;
            margin-top: 25px;
            border-radius: 8px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background-color: white;
        }

        thead th {
            position: sticky;
            top: 0;
            background-color: #4B2E2E;
            color: #F5F5DC;
            z-index: 999;
            padding: 12px;
            font-weight: 600;
        }

        td {
            padding: 12px 15px;
            text-align: center;
            border-bottom: 1px solid #ddd;
        }

        tr:hover {
            background-color: #f2f2e9;
        }

        .btn-primary, .btn-danger {
            padding: 6px 14px;
            border: none;
            border-radius: 5px;
            color: white;
            font-weight: 500;
            text-decoration: none;
            transition: background 0.3s ease;
            display: inline-block;
        }

        .btn-primary {
            background-color: #6a4b4b;
            margin-right: 8px;
        }

        .btn-primary:hover {
            background-color: #523636;
        }

        .btn-danger {
            background-color: #b33a3a;
        }

        .btn-danger:hover {
            background-color: #932323;
        }

        img {
            border-radius: 6px;
        }

        @@media (max-width: 768px) {
            .main-content {
                margin-left: 0;
                padding: 20px;
            }

           

            table, thead, tbody, th, td, tr {
                display: block;
            }

            thead {
                display: none;
            }

            td {
                padding-left: 50%;
                position: relative;
            }

            td::before {
                position: absolute;
                top: 12px;
                left: 15px;
                white-space: nowrap;
                font-weight: 600;
            }
        }
    </style>
</head>
<body>

    
        <div class="main-content">
            <h2>All Products</h2>
            <a class="btn btn-success" href="@Url.Action("Create", "Product")">Add New Product</a>

            <div class="product-table-container">
                <table>
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Price</th>
                            <th>Qty</th>
                            <th>Image</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            <tr>
                                <td>@(i + 1)</td>
                                <td>@Model[i].ProductName</td>
                                <td>@Model[i].Description</td>
                                <td>@Model[i].Price</td>
                                <td>@Model[i].Quantity</td>
                                <td>
                                    <img src="@Model[i].ImagePath" width="70" height="70" />
                                </td>
                                <td>
                                    <a class="btn btn-primary" href="@Url.Action("Edit", "Product", new { id = Model[i].ProductId })">Edit</a>
                                    <a class="btn btn-danger" href="@Url.Action("Delete", "Product", new { id = Model[i].ProductId })">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    

</body>
</html>
